<?xml version="1.0"?>

<launch>

  <!-- ===================== -->
  <!-- Top-level arguments   -->
  <!-- ===================== -->
  <arg name="use_sim_time" default="true"/>

  <arg name="map_path"
       default="$(find-pkg-share andino_rmf_maps)/maps/andino_office/andino_office.building.yaml"/>

  <arg name="viz_config_file"
       default="$(find-pkg-share andino_rmf_sim)/rviz_config/office.rviz"/>

  <arg name="map_name" default="L1"/>
  <arg name="server_uri" default="ws://localhost:8000/_internal"/>

  <!-- ===================== -->
  <!-- Common launch         -->
  <!-- RMF resources, etc.   -->
  <!-- ===================== -->
  <include file="$(find-pkg-share andino_rmf_sim)/launch/common.launch.py">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="viz_config_file" value="$(var viz_config_file)"/>
    <arg name="map_name" value="$(var map_name)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- Fleet adapter -->
  <group>
    <group if="$(var use_sim_time)">
      <node pkg="oro_fleet_adapter"
            exec="fleet_adapter"
            args="-c $(find-pkg-share oro_fleet_adapter)/demo.andino.config.yaml -n $(find-pkg-share andino_rmf_maps)/maps/andino_office/nav_graphs/0.yaml -sim"
            output="both">

        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="server_uri" value="$(var server_uri)"/>
      </node>
    </group>

    <group unless="$(var use_sim_time)">
      <node pkg="oro_fleet_adapter"
            exec="fleet_adapter"
            args="-c $(find-pkg-share oro_fleet_adapter)/demo.andino.config.yaml -n $(find-pkg-share andino_rmf_maps)/maps/andino_office/nav_graphs/0.yaml"
            output="both">

        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="server_uri" value="$(var server_uri)"/>
      </node>
    </group>
  </group>

</launch>